# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://zig-zag-beta.vercel.app,https://zigzag-admin.vercel.app

# Database
POSTGRES_DB=zigzag
POSTGRES_USER=zigzag
POSTGRES_PASSWORD=zigzag
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# OTP
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN=30
# Show OTP in API response (development helper, NEVER enable in prod)
OTP_DEBUG_RETURN_CODE=True
# SMS provider (eskiz / playmobile). Empty = console backend
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# Telegram bot (xodim/menejer/admin bildirishnomalari). Bo'sh = bot ishlamaydi.
TELEGRAM_BOT_TOKEN=

# AI provider
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-haiku-4-5-20251001
AI_CHAT_MODEL_STRONG=claude-sonnet-4-6
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_INPUT_CHARS=2000
AI_CONTEXT_WINDOW_MESSAGES=10
# When no API key is set the AI layer falls back to a deterministic stub
AI_STUB_MODE=True

# Object storage (S3 / MinIO). Leave empty to use local media.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Payments
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_ALLOWED_IPS=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_ALLOWED_IPS=

# Sentry
SENTRY_DSN=
